{
  "name": "vocium",
  "version": "0.2.0",
  "description": "Desktop AI voice input — Tauri 2 shell (Rust) + voice-core (TypeScript) running in the webview",
  "type": "module",
  "license": "MIT",
  "author": "Hereisaa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hereisaa/vocium.git"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build -w packages/voice-core",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:core && npm run build:ui",
    "watch:ui": "node scripts/build-ui.mjs --watch",
    "test": "npm run test -w packages/voice-core",
    "test:watch": "vitest --root packages/voice-core",
    "probe:groq": "node scripts/probe-groq.mjs",
    "icons": "node scripts/gen-icons.mjs && tauri icon app-tauri/src-tauri/icons/1024x1024.png --output app-tauri/src-tauri/icons",
    "banner": "node scripts/gen-banner.mjs",
    "vad:assets": "node scripts/copy-vad-assets.mjs",
    "dev": "npm run build && npm run vad:assets && tauri dev --config app-tauri/src-tauri/tauri.conf.json",
    "package": "tauri build --config app-tauri/src-tauri/tauri.conf.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-http": "~2.7.0",
    "onnxruntime-web": "^1.26.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.4",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
